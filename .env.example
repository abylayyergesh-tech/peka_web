# API origin for production builds. Empty = same origin behind /api proxy.
VITE_API_URL=
# Currency suffix shown next to money values (e.g. ₸ or ₽). Empty = none.
VITE_CURRENCY=
# Адрес личного кабинета сотрудника (peka_staff). Показывается на стоп-экране
# участнику без административных прав: «ваша смена и заявления — там».
VITE_STAFF_URL=
